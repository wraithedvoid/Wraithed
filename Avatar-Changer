local function ensureSnapshot(char, hum)
  if snapshot and snapshot.char == char then return snapshot end
  local okDesc, originalDesc = pcall(function() return hum:GetAppliedDescription() end)
  local snap = {
    char = char, originalDesc = okDesc and originalDesc or nil,
    clothes = {}, accessories = {},
    animateTemplate = captureAnimateTemplate(char),
    requiresNeck = hum.RequiresNeck, breakJoints = hum.BreakJointsOnDeath,
    bodyChanged = false, clothesChanged = false, accessoriesChanged = false, animsChanged = false,
  }
  for _, child in ipairs(char:GetChildren()) do
    if not child:GetAttribute(TAG) then
      if isClothing(child) then table.insert(snap.clothes, child:Clone())
      elseif isAccessory(child) then table.insert(snap.accessories, child:Clone()) end
    end
  end
  table.insert(connections, hum.Died:Connect(function()
    if lastDesc then keepPaused = true end
  end))
  snapshot = snap
  return snapshot
end

local function copyBody(humanoid, targetUserId)
  local success, err = pcall(function()
    local targetDescription = Players:GetHumanoidDescriptionFromUserId(targetUserId)
    local currentDescription = humanoid:GetAppliedDescription()
    local properties = { "Head", "Torso", "LeftArm", "RightArm", "LeftLeg", "RightLeg",
      "BodyTypeScale", "ProportionScale", "HeightScale", "WidthScale", "DepthScale", "HeadScale" }
    for _, p in ipairs(properties) do currentDescription[p] = targetDescription[p] end
    humanoid:ApplyDescriptionAsync(currentDescription)
  end)
  if not success then warn("Body copy failed:", err) end
  return success, err
end

-- KORBLOX: builds the real Korblox leg from a dummy model at YOUR proportions, hides your real right
-- upper leg, lower leg and foot, and welds the Korblox parts onto them by the rig attachment each
-- joint uses, so the leg sits exactly where your own leg is and moves with every animation.
local korbloxBase = nil      -- original Transparency of the real leg parts
local korbloxSerial = 0      -- newest call wins if the button is tapped again while a leg is building

local function clearKorbloxParts(char)
  for _, p in ipairs(KORBLOX_PARTS) do
    local old = char:FindFirstChild(p[3])
    if old then old:Destroy() end
  end
end

local function restoreRealLeg(char)
  if korbloxBase and korbloxBase.char == char then
    for name, t in pairs(korbloxBase.t) do
      local part = char:FindFirstChild(name)
      if part and part:IsA("BasePart") then part.Transparency = t end
    end
  end
  korbloxBase = nil
end

local function setKorbloxMesh(char, enabled)
  korbloxSerial = korbloxSerial + 1
  local mine = korbloxSerial
  clearKorbloxParts(char)
  restoreRealLeg(char)
  if not enabled then return true end

  local hum = char:FindFirstChildOfClass("Humanoid")
  if not hum then return false end
  for _, p in ipairs(KORBLOX_PARTS) do
    local real = char:FindFirstChild(p[1])
    if not (real and real:IsA("BasePart")) then return false end
  end

  -- a blank description with only the Korblox leg, at the same scale as your body
  local desc = Instance.new("HumanoidDescription")
  desc.RightLeg = KORBLOX_DESC_ID
  local okApplied, applied = pcall(function() return hum:GetAppliedDescription() end)
  if okApplied and applied then
    for _, prop in ipairs({ "BodyTypeScale", "ProportionScale", "HeightScale", "WidthScale", "DepthScale", "HeadScale" }) do
      pcall(function() desc[prop] = applied[prop] end)
    end
  end

  local okModel, model = pcall(function()
    return Players:CreateHumanoidModelFromDescription(desc, hum.RigType)
  end)
  if not (okModel and model) then
    warn("Failed to generate Korblox model.")
    return false
  end

  -- the character changed or the button was tapped again while this leg was building
  if mine ~= korbloxSerial or not char.Parent or LocalPlayer.Character ~= char then
    model:Destroy()
    return true
  end

  -- without the Korblox upper leg there is nothing to show, so your real leg is left alone
  if not model:FindFirstChild(KORBLOX_PARTS[1][1]) then
    model:Destroy()
    warn("Korblox model has no upper leg.")
    return false
  end

  korbloxBase = { char = char, t = {} }
  local built = 0
  for _, p in ipairs(KORBLOX_PARTS) do
    local real = char:FindFirstChild(p[1])
    local dummy = model:FindFirstChild(p[1])
    if real and dummy then
      local clone = dummy:Clone()
      clone.Name = p[3]
      for _, d in ipairs(clone:GetDescendants()) do
        if d:IsA("JointInstance") or d:IsA("Weld") or d:IsA("WeldConstraint") or d:IsA("BaseScript") or d:IsA("WrapTarget") then
          d:Destroy()
        end
      end
      clone.Anchored = false
      clone.CanCollide = false
      clone.CanTouch = false
      clone.CanQuery = false
      clone.Massless = true
      clone.Transparency = p[4]
      clone:SetAttribute(TAG, true)

      local weld = Instance.new("Weld")
      weld.Name = "KorbloxWeld"
      weld.Part0 = real
      weld.Part1 = clone
      local a0, a1 = real:FindFirstChild(p[2]), clone:FindFirstChild(p[2])
      if a0 and a1 and a0:IsA("Attachment") and a1:IsA("Attachment") then
        weld.C0 = a0.CFrame
        weld.C1 = a1.CFrame
      end
      clone.CFrame = real.CFrame * weld.C0 * weld.C1:Inverse()

      korbloxBase.t[p[1]] = real.Transparency
      real.Transparency = 1
      clone.Parent = char
      weld.Parent = clone
      built = built + 1
    end
  end
  model:Destroy()

  if built < #KORBLOX_PARTS then
    log("Korblox built", built, "of", #KORBLOX_PARTS, "parts")
  end
  return built > 0
end

local headBase = nil
local function setHeadless(char, on)
  local head = char:FindFirstChild("Head")
  if not (head and head:IsA("BasePart")) then return false end
  if not headBase or headBase.char ~= char then
    headBase = { char = char, transparency = head.Transparency }
  end
  head.Transparency = on and 1 or headBase.transparency
  return true
end

local function refreshOverlays(char)
  local ok1 = setHeadless(char, overlay.headless)
  local ok2 = setKorbloxMesh(char, overlay.korblox)
  return ok1 and ok2
end

local function dropOverlayBase(char)
  if headBase and headBase.char == char then setHeadless(char, false) end
  headBase = nil

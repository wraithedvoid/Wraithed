local function waitFrames(n) for _ = 1, n do RunService.Heartbeat:Wait() end end
local function trim(s) return (s:match("^%s*(.-)%s*$")) end

local function retry(fn, tries)
  local lastErr
  for i = 1, tries do
    local ok, res = pcall(fn)
    if ok and res ~= nil then return res end
    lastErr = res
    if i < tries then task.wait(0.4 * i) end
  end
  return nil, lastErr
end

local function runSafely(fn, ...)
  local called, ok, msg = pcall(fn, ...)
  if not called then return false, tostring(ok) end
  return ok, msg
end


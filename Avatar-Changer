end
local function makeButton(parent, text, size, position, colorA, colorB)
  local holder = new("Frame", { Size = size, Position = position, BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = parent })
  corner(holder, 12); gradient(holder, colorA, colorB, 90)

table.insert(connections, LocalPlayer.CharacterAdded:Connect(function(char)
  if keepPaused then
    keepPaused = false
    lastDesc, lastUser = nil, nil
    if options.keep then
      setStatus("You died while this look was on, so keep is paused. Press Apply to try again.", "err")
    end
    task.spawn(overlaysWhenReady, char)
    return
  end
  if not (options.keep and lastDesc and lastUser) then
    task.spawn(overlaysWhenReady, char)
    return
  end
  task.spawn(function()
    if not waitUntilReady(char) then return end
    while busy do task.wait(0.1) end
    if LocalPlayer.Character ~= char or not lastDesc or not lastUser then return end
    setBusy(true)
    local ok, msg = runSafely(applyLook, lastUser, lastDesc, readOptions())
    setBusy(false)
    if ok then
      setStatus("Re-applied " .. lastUser.display .. " after respawn.", "ok")
    else
      setStatus(msg or "Couldn't re-apply after respawn.", "err")
    end
  end)
end))

local dragging, dragStart, startPos = false, nil, nil
table.insert(connections, titleBar.InputBegan:Connect(function(input)
  if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
    dragging = true
    dragStart = input.Position
    startPos = main.Position
  end
end))
table.insert(connections, UserInputService.InputEnded:Connect(function(input)
  if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
end))
table.insert(connections, UserInputService.InputChanged:Connect(function(input)
  if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
    local delta = input.Position - dragStart
    main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
  end
end))

table.insert(connections, UserInputService.InputBegan:Connect(function(input, processed)
  if processed then return end
  if input.KeyCode == TOGGLE_KEY then setWindowVisible(not main.Visible) end
end))

local function destroyHub()
  for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
  connections = {}
  if screenGui then screenGui:Destroy() end
end


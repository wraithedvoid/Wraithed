local function runApply()
  if busy then return end
  local text = trim(usernameBox.Text)
  if text == "" then
    setStatus("Type a username or user ID first.", "err")
    return
  end
  setBusy(true)
  task.spawn(function()
    local ok, msg = runSafely(function()
      setStatus("Looking up " .. text .. "...", "info")
      local user, err = lookupUser(text)
      if not user then return false, err end
      showPreview(user, "PREVIEW")
      setStatus("Downloading avatar...", "info")
      local desc = getDescription(user)
      if not desc then return false, "Couldn't load " .. user.name .. "'s avatar." end
      setStatus("Applying look...", "info")
      local applied, note = applyLook(user, desc, readOptions())
      if not applied then
        lastDesc, lastUser = nil, nil
        return false, note
      end
      lastDesc, lastUser = desc, user
      showPreview(user, "WEARING")
      local extra = (note and note ~= "") and (" " .. note) or ""
      return true, ("Wearing %s (@%s). Press Remove to undo.%s"):format(user.display, user.name, extra)
    end)
    setBusy(false)
    setStatus(msg or (ok and "Done." or "Apply failed."), ok and "ok" or "err")
  end)
end

local function runRemove()
  if busy then return end
  setBusy(true)
  setStatus("Restoring your original look...", "info")
  task.spawn(function()
    local ok, msg = runSafely(restoreOriginal)
    setBusy(false)
    if ok then
      lastDesc, lastUser = nil, nil
      showPreview({ id = LocalPlayer.UserId, name = LocalPlayer.Name, display = LocalPlayer.DisplayName }, "YOU")
      setStatus(msg or "Back to your original look.", "ok")
    else
      setStatus(msg or "Remove failed.", "err")
    end
  end)
end


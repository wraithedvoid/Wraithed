local playerRows = {}
local function refreshPlayers()
  for _, r in ipairs(playerRows) do r:Destroy() end
  playerRows = {}
  local list = Players:GetPlayers()
  table.sort(list, function(a, b) return a.Name:lower() < b.Name:lower() end)
  local order = 1
  for _, plr in ipairs(list) do
    if plr ~= LocalPlayer and order <= 25 then
      local row = new("TextButton", {
        LayoutOrder = order, Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = THEME.field,
        BorderSizePixel = 0, AutoButtonColor = true, Text = "", Parent = playersCard,
      })
      corner(row, 10)
      corner(new("ImageLabel", {
        Position = UDim2.new(0, 6, 0.5, -14), Size = UDim2.fromOffset(28, 28), BackgroundColor3 = THEME.bg,
        BorderSizePixel = 0, Image = ("rbxthumb://type=AvatarHeadShot&id=%d&w=48&h=48"):format(plr.UserId), Parent = row,
      }), 14)
      label(row, { Position = UDim2.new(0, 42, 0, 3), Size = UDim2.new(1, -50, 0, 18), Font = Enum.Font.GothamMedium, TextSize = 13, TextTruncate = Enum.TextTruncate.AtEnd, Text = plr.DisplayName })
      label(row, { Position = UDim2.new(0, 42, 0, 21), Size = UDim2.new(1, -50, 0, 14), TextSize = 11, TextColor3 = THEME.sub, TextTruncate = Enum.TextTruncate.AtEnd, Text = "@" .. plr.Name })
      row.MouseButton1Click:Connect(function()
        usernameBox.Text = plr.Name
        runPreview()
      end)
      table.insert(playerRows, row)
      order = order + 1
    end
  end
  if order == 1 then
    table.insert(playerRows, label(playersCard, { LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 28), TextSize = 12, TextColor3 = THEME.sub, Text = "No other players in this server." }))
  end
end

local function waitUntilReady(char)
  local hum = char:WaitForChild("Humanoid", 10)
  if not hum then return nil end
  local startedAt = os.clock()
  while os.clock() - startedAt < 10 do
    local ok, loaded = pcall(function() return LocalPlayer:HasAppearanceLoaded() end)
    if not ok or loaded then break end
    task.wait(0.2)
  end
  task.wait(0.5)
  return hum
end

local function overlaysWhenReady(char)
  if not waitUntilReady(char) then return end
  while busy do task.wait(0.1) end
  if LocalPlayer.Character ~= char then return end
  if overlay.korblox or overlay.headless then
    pcall(refreshOverlays, char)
  end
end

refreshPlayers()

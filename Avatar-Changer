  local ok, model = pcall(function() return Players:CreateHumanoidModelFromDescription(desc, hum.RigType) end)
  if not ok or not model then return nil, "Couldn't build that look: " .. tostring(model) end
  return model
end

local function applyLook(user, desc, opts)
  local char, hum = getCharacter()
  if not char then return false, "No character yet. Wait for your character to spawn." end
  if hum.Health <= 0 then return false, "You're dead right now. Respawn, then try again." end
  watchStart = os.clock(); watchUntil = watchStart + 120
  local startHrp = char:FindFirstChild("HumanoidRootPart")
  local startCF = startHrp and startHrp.CFrame
  local snap = ensureSnapshot(char, hum)
  local guard = lockRig(hum)
  revertAll(char, hum, snap)
  dropOverlayBase(char)

  local model, err = buildLookModel(hum, desc)
  if not model then releaseRig(hum, snap, guard, true); return false, err end

  local notes = {}
  local ok, applyErr = pcall(function()
    if opts.body then
      snap.bodyChanged = true
      local copied, copyErr = copyBody(hum, user.id)
      if copied then table.insert(notes, "Body copied from them.")
      else table.insert(notes, "Body copy failed: " .. tostring(copyErr)) end
    elseif snap.bodyChanged and snap.originalDesc then
      pcall(function() hum:ApplyDescriptionAsync(snap.originalDesc) end)
      snap.bodyChanged = false
    end

    if opts.clothes then snap.clothesChanged = true; applyClothes(char, model) end
    if opts.accessories then
      snap.accessoriesChanged = true
      local skippedAcc = applyAccessories(char, model)
      if skippedAcc > 0 then table.insert(notes, skippedAcc .. " accessory couldn't be attached.") end
    end
    if opts.animations then
      local animator = hum:FindFirstChildOfClass("Animator")
      if not animator then animator = Instance.new("Animator"); animator.Parent = hum end
      local ids, failed = resolveAnimationIds(animator, desc)
      local applied, note = applyAnimations(char, hum, snap, ids)
      if not applied then table.insert(notes, note)
      elseif #failed == 0 then table.insert(notes, "Animations: all from their pack.")
      else table.insert(notes, "Animations: default for " .. table.concat(failed, ", ") .. " (their file didn't load).") end
    end
  end)

  model:Destroy()
  if not ok then pcall(revertAll, char, hum, snap) end
  waitFrames(3)
  pcall(refreshOverlays, char)

  holdRig(char, hum, WATCH_SECONDS, startCF)
  releaseRig(hum, snap, guard, true)
  watchUntil = os.clock() + 25

  if not ok then return false, "Apply failed: " .. tostring(applyErr) end
  keepPaused = false
  return true, table.concat(notes, " ")
end

local function restoreOriginal()
  local char, hum = getCharacter()
  if not char or not snapshot or snapshot.char ~= char then return true, "You're already wearing your original look." end
  watchStart = os.clock(); watchUntil = watchStart + 60
  local guard = lockRig(hum)
  dropOverlayBase(char)

  local bodyOk, bodyErr = true, nil
  if snapshot.bodyChanged then
    if snapshot.originalDesc then
      bodyOk, bodyErr = pcall(function() hum:ApplyDescriptionAsync(snapshot.originalDesc) end)
    else bodyOk, bodyErr = false, "no saved description to restore from" end
    snapshot.bodyChanged = false
  end

  revertAll(char, hum, snapshot)
  refreshOverlays(char)
  waitFrames(5)
  holdRig(char, hum, 1, nil)
  releaseRig(hum, snapshot, guard, true)

  if not bodyOk then return false, "Couldn't restore your body: " .. tostring(bodyErr) end
  return true, "Back to your original look."
end

local function lookupUser(text)
  text = trim(text):gsub("^@", "")
  local id = tonumber(text)
  if id and id > 0 then id = math.floor(id)
  else
    local result = retry(function() return Players:GetUserIdFromNameAsync(text) end, 2)
    if not result then return nil, "No Roblox user found called '" .. text .. "'." end
    id = result
  end
  local name, display
  local infos = retry(function() return UserService:GetUserInfosByUserIdsAsync({ id }) end, 2)
  if infos and infos[1] then name, display = infos[1].Username, infos[1].DisplayName end
  if not name then
    local result = retry(function() return Players:GetNameFromUserIdAsync(id) end, 2)
    if result then name = result end
  end
  if not name then return nil, "No Roblox user found with ID " .. tostring(id) .. "." end
  return { id = id, name = name, display = display or name }
end

local function getDescription(user)
  local cached = descCache[user.id]
  if cached and os.clock() - cached.t < 120 then return cached.desc end
  local desc = retry(function() return Players:GetHumanoidDescriptionFromUserId(user.id) end, 3)
  if desc then descCache[user.id] = { desc = desc, t = os.clock() } end
  return desc
end


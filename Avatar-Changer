local function lockRig(hum)
  local guard = { health = hum.Health }
  pcall(function()
    hum.RequiresNeck = false
    hum.BreakJointsOnDeath = false
    hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
  end)
  guard.conn = hum.HealthChanged:Connect(function(h)
    if hum.Parent and h < guard.health then pcall(function() hum.Health = guard.health end) end
  end)
  return guard
end

local function releaseRig(hum, snap, guard, restoreAll)
  if guard and guard.conn then guard.conn:Disconnect() end
  if not restoreAll then return end
  pcall(function()
    hum.BreakJointsOnDeath = snap.breakJoints
    hum:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
    hum.RequiresNeck = snap.requiresNeck
  end)
end

local function holdRig(char, hum, seconds, startCF)
  local hrp = char:FindFirstChild("HumanoidRootPart")
  local safeCF = startCF or (hrp and hrp.CFrame)
  local voidY = -500
  pcall(function() voidY = workspace.FallenPartsDestroyHeight end)
  voidY = voidY + 100
  local deadline = os.clock() + seconds
  while os.clock() < deadline do
    if hum.Parent == nil or char.Parent == nil then return false end
    hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
      local y = hrp.Position.Y
      if y < voidY and safeCF then
        pcall(function()
          hrp.AssemblyLinearVelocity = Vector3.zero
          hrp.AssemblyAngularVelocity = Vector3.zero
          hrp.CFrame = safeCF
        end)
      elseif y >= voidY and hum.FloorMaterial ~= Enum.Material.Air then
        safeCF = hrp.CFrame
      end
    end
    task.wait(0.25)
  end
  return true
end


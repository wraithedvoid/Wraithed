  end

  overlay[key] = not overlay[key]
  renderChip(btn, overlay[key])
  if key == "korblox" and overlay.korblox then setStatus("Building Korblox...", "info") end

  local ok
  if key == "headless" then ok = setHeadless(char, overlay.headless)
  else ok = setKorbloxMesh(char, overlay.korblox) end

  if not ok then
    overlay[key] = false
    renderChip(btn, false)
    setStatus(title .. " couldn't apply properly. Missing body parts.", "err")
  else
    setStatus(title .. (overlay[key] and " on." or " off."), "ok")
  end
end


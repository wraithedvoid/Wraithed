local function findBodyAttachment(char, attachName)
  for _, part in ipairs(char:GetChildren()) do
    if part:IsA("BasePart") then
      local att = part:FindFirstChild(attachName)
      if att and att:IsA("Attachment") then return part, att end
    end
  end
  return nil, nil
end

local function markLocal(accessory, handle)
  handle.Massless = true; handle.CanCollide = false; handle.CanTouch = false; handle.CanQuery = false
  accessory:SetAttribute(TAG, true)
end

local function placeAccessory(char, accessory, isLocal)
  local handle = accessory:FindFirstChild("Handle")
  if not (handle and handle:IsA("BasePart")) then return false end
  local bodyPart, c0, c1
  for _, handleAtt in ipairs(handle:GetChildren()) do
    if handleAtt:IsA("Attachment") then
      local part, att = findBodyAttachment(char, handleAtt.Name)
      if part then bodyPart, c0, c1 = part, att.CFrame, handleAtt.CFrame; break end
    end
  end
  if not bodyPart then
    local srcWeld = handle:FindFirstChild("AccessoryWeld") or handle:FindFirstChildWhichIsA("Weld")
    if srcWeld and srcWeld.Part0 then
      local match = char:FindFirstChild(srcWeld.Part0.Name)
      if match and match:IsA("BasePart") then bodyPart, c0, c1 = match, srcWeld.C0, srcWeld.C1 end
    end
  end
  if not bodyPart then
    if handle:FindFirstChildWhichIsA("WrapLayer") then
      if isLocal then markLocal(accessory, handle) end
      accessory.Parent = char; return true
    end
    return false
  end
  for _, c in ipairs(handle:GetChildren()) do
    if c:IsA("Weld") or c:IsA("WeldConstraint") or c:IsA("Motor6D") then c:Destroy() end
  end
  if isLocal then markLocal(accessory, handle) end
  accessory.Parent = char
  local weld = Instance.new("Weld")
  weld.Name = "LocalWeld"; weld.Part0 = bodyPart; weld.Part1 = handle; weld.C0 = c0; weld.C1 = c1; weld.Parent = handle
  return true
end

local function applyAccessories(char, model)
  for _, c in ipairs(char:GetChildren()) do if isAccessory(c) then c:Destroy() end end
  local skipped = 0
  for _, c in ipairs(model:GetChildren()) do
    if isAccessory(c) then
      local acc = c:Clone()
      if not placeAccessory(char, acc, true) then acc:Destroy(); skipped = skipped + 1 end
    end
  end
  return skipped
end

local function restoreAccessories(char, snap)
  for _, c in ipairs(char:GetChildren()) do if isAccessory(c) then c:Destroy() end end
  for _, o in ipairs(snap.accessories) do
    local acc = o:Clone()
    if not placeAccessory(char, acc, false) then acc.Parent = char end
  end
end

local function stopTracks(hum)
  pcall(function()
    local animator = hum:FindFirstChildOfClass("Animator")
    for _, track in ipairs((animator or hum):GetPlayingAnimationTracks()) do track:Stop(0.1) end
  end)
end
local function installAnimate(char, hum, fresh)
  stopTracks(hum)
  local old = char:FindFirstChild("Animate"); if old then old:Destroy() end
  fresh.Disabled = false; fresh.Parent = char
  waitFrames(2)
end
local function probeAnimation(animator, id)
  local anim = Instance.new("Animation"); anim.AnimationId = "rbxassetid://" .. tostring(id)
  local preloadDone = false
  task.spawn(function() pcall(function() ContentProvider:PreloadAsync({ anim }) end); preloadDone = true end)
  local valid = false
  local ok, track = pcall(function() return animator:LoadAnimation(anim) end)
  if ok and track then
    local deadline = os.clock() + 6
    while os.clock() < deadline do
      if track.Length > 0 then valid = true; break end
      if preloadDone then
        local settle = os.clock() + 1
        while os.clock() < settle and track.Length == 0 do RunService.Heartbeat:Wait() end
        valid = track.Length > 0; break
      end
      RunService.Heartbeat:Wait()
    end
    pcall(function() track:Destroy() end)
  end
  pcall(function() anim:Destroy() end)
  return valid
end
local function resolveAnimationIds(animator, desc)
  local ids, failed = {}, {}
  local pending = #ANIMATION_SLOTS
  for _, slot in ipairs(ANIMATION_SLOTS) do
    task.spawn(function()
      local fallback = DEFAULT_IDS[slot.prop]
      local okRead, value = pcall(function() return desc[slot.prop] end)
      local want = okRead and tonumber(value or 0) or 0
      local good = false
      if want == fallback then good = true
      elseif want > 0 then
        local okProbe, res = pcall(probeAnimation, animator, want); good = okProbe and res == true
      end
      if good then ids[slot.prop] = want
      else ids[slot.prop] = fallback; if want > 0 then table.insert(failed, slot.folder) end end
      pending = pending - 1
    end)
  end
  while pending > 0 do task.wait() end
  table.sort(failed)
  return ids, failed
end
local function applyAnimations(char, hum, snap, ids)
  if not snap.animateTemplate then
    if not char:FindFirstChild("Animate") then char:WaitForChild("Animate", 3) end
    snap.animateTemplate = captureAnimateTemplate(char)
  end
  if not snap.animateTemplate then return false, "Animations skipped (no Animate script)." end
  local ok, fresh = pcall(function() return snap.animateTemplate:Clone() end)
  if not ok or not fresh then return false, "Animations skipped (clone failed)." end
  for _, slot in ipairs(ANIMATION_SLOTS) do
    local folder = fresh:FindFirstChild(slot.folder)
    if folder then
      local url = "rbxassetid://" .. tostring(ids[slot.prop])
      for _, anim in ipairs(folder:GetChildren()) do if anim:IsA("Animation") then anim.AnimationId = url end end
    end
  end
  snap.animsChanged = true
  installAnimate(char, hum, fresh)
  return true, ""
end
local function restoreAnimations(char, hum, snap)
  if not snap.animateTemplate then return end
  local ok, fresh = pcall(function() return snap.animateTemplate:Clone() end)
  if ok and fresh then installAnimate(char, hum, fresh) end
end

local function revertAll(char, hum, snap)
  clearLocalLook(char)
  if snap.clothesChanged then restoreClothes(char, snap); snap.clothesChanged = false end
  if snap.accessoriesChanged then restoreAccessories(char, snap); snap.accessoriesChanged = false end
  if snap.animsChanged then restoreAnimations(char, hum, snap); snap.animsChanged = false end
end

